	pages = {37--39},
	file = {Philippou et al. - 2024 - 3D Simulation Study of a Novel 1200 V IGBT Concept.pdf:C\:\\Users\\kgr81sgp\\Zotero for Bosch\\storage\\7GVS6V7Q\\Philippou et al. - 2024 - 3D Simulation Study of a Novel 1200 V IGBT Concept.pdf:application/pdf},
